msgstr "@APP_NAME@"

#: data/org.gnome.Ptyxis.desktop.in.in:3
msgid "A container-oriented terminal for GNOME"
msgstr "Орієнтований на контейнери термінал для GNOME"

#: data/org.gnome.Ptyxis.desktop.in.in:12 src/ptyxis-preferences-window.ui:680
#: src/ptyxis-tab.c:1679 src/ptyxis-util.c:328
msgid "Terminal"
msgstr "Термінал"

