#: data/org.gnome.Ptyxis.desktop.in.in:2
#: data/org.gnome.Ptyxis.metainfo.xml.in.in:6
msgid "@APP_NAME@"
msgstr "@APP_NAME@"

#: data/org.gnome.Ptyxis.desktop.in.in:3
msgid "A container-oriented terminal for GNOME"
msgstr "Um terminal orientado a contêineres para GNOME"

#: data/org.gnome.Ptyxis.desktop.in.in:12 src/ptyxis-preferences-window.ui:686
#: src/ptyxis-tab.c:1698 src/ptyxis-util.c:328
msgid "Terminal"
msgstr "Terminal"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.Ptyxis.desktop.in.in:14
msgid "terminal;prompt;ptyxis;shell;command;commandline;cmd;cli;console;container;podman;toolbox;distrobox;"
msgstr ""
"terminal;prompt;ptyxis;shell;comando;linha de "
"comando;cmd;cli;container;contêiner;podman;toolbox;distrobox;"

#: data/org.gnome.Ptyxis.desktop.in.in:24
#: src/org.gnome.Ptyxis.gschema.xml.in:443 src/ptyxis-preferences-window.ui:759
msgid "New Window"
msgstr "Nova janela"

#: data/org.gnome.Ptyxis.desktop.in.in:28
#: src/org.gnome.Ptyxis.gschema.xml.in:437 src/ptyxis-preferences-window.ui:788
msgid "New Tab"
msgstr "Nova aba"

#: data/org.gnome.Ptyxis.desktop.in.in:32
#: src/org.gnome.Ptyxis.gschema.xml.in:455 src/ptyxis-preferences-window.ui:995
msgid "Preferences"
msgstr "Preferências"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:7
msgid "Container-oriented terminal"
msgstr "Terminal orientado a contêineres"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:9
msgid ""
"Ptyxis is a terminal for GNOME that focuses on ease-of-use in a world of "
"containers."
msgstr ""
"Ptyxis é um terminal para GNOME que se concentra na facilidade de uso em um "
"mundo de contêineres."

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:13
msgid "Features:"
msgstr "Recursos:"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:15
msgid ""
"Remembers current container when opening a new tab with support for podman, "
"toolbox, distrobox, and more"
msgstr ""
"Lembra o contêiner atual ao abrir uma nova aba com suporte para podman, "
"toolbox, distrobox e mais"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:16
msgid "Configurable keyboard shortcuts"
msgstr "Atalhos de teclado configuráveis"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:17
msgid "Modern interface which integrates the palette with the window styling"
msgstr "Interface moderna que integra a paleta com o estilo da janela"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:18
msgid "User-installable color palettes"
msgstr "Paletas de cores instaláveis ​​pelo usuário"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:19
msgid "Support for preferences profiles with container integration"
msgstr "Suporte para perfis de preferências com integração com contêineres"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:20
msgid "Integrated color palettes with light and dark support"
msgstr "Paletas de cores integradas com suporte claro e escuro"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:21
msgid "Tabbed interface with tab overviews"
msgstr "Interface com abas e visões gerais das abas"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:22
msgid "Efficient foreground process tracking denoting sudo and SSH"
msgstr ""
"Rastreamento eficiente de processos em primeiro plano denotando sudo e SSH"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:23
msgid "Support for transparent terminal backgrounds"
msgstr "Suporte para fundos de tela transparentes de terminal"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:24
msgid "Separate process mode for terminal-based applications"
msgstr "Modo de processo separado para aplicativos de terminais"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:25
msgid "Support for pinned tabs and saved sessions"
msgstr "Suporte para abas fixadas e sessões salvas"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:26
msgid "Terminal tabs are run within separate cgroups"
msgstr "Abas de terminal são executadas com cgroups separados"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:27
msgid "Terminal inspector to help when writing terminal-based applications"
msgstr ""
"Inspetor de terminal para ajudar ao escrever aplicativos baseadas de terminal"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:54
msgid "A column and row size indicator is displayed when resizing the window"
msgstr ""
"Um indicador de tamanho de coluna e linha é exibido ao redimensionar a janela"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:59
msgid "Containers are automatically discovered and displayed"
msgstr "Os contêineres são descobertos e exibidos automaticamente"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:64
msgid "Many behaviors of the terminal may be tweaked to user preference"
msgstr ""
"Muitos comportamentos do terminal podem ser ajustados de acordo com a "
"preferência do usuário"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:69
msgid "You may rename a tab by providing a prefix to the title"
msgstr "Você pode renomear uma aba fornecendo um prefixo para o título"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:74
msgid "Palettes provide an integrated dark mode"
msgstr "As paletas fornecem um modo escuro integrado"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:79
msgid "You can see an overview of your tabs at any time"
msgstr "Você pode ver uma visão geral de suas abas a qualquer momento"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:84
msgid "Many shortcuts may be remapped to user preference"
msgstr "Muitos atalhos pode ser remapeado para as preferências do usuário"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:89
msgid "Built-in color palettes provide both dark and light mode variants"
msgstr "Paletas de cores embutidos oferecem variantes de modo claro e escuro"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:94
msgid ""
"Profiles allow for overriding a number of features such as default container"
msgstr ""
"Perfis permitem substituir uma série de recursos, como contêiner padrão"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:99
msgid "The terminal will remind you when you're root on the local system"
msgstr ""
"O terminal irá lembrá-lo quando você estiver como root no sistema local"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:104
msgid "The terminal will remind you when you're on a remote system"
msgstr "O terminal irá lembrá-lo quando você estiver em um sistema remoto"

#: src/org.gnome.Ptyxis.gschema.xml.in:101
msgid "Default Profile UUID"
msgstr "UUID do perfil padrão"

#: src/org.gnome.Ptyxis.gschema.xml.in:102
msgid "The UUID of the default profile"
msgstr "O UUID do perfil padrão"

#: src/org.gnome.Ptyxis.gschema.xml.in:107
msgid "UUIDs of all Profiles"
msgstr "UUIDs de todos os perfis"

#: src/org.gnome.Ptyxis.gschema.xml.in:108
msgid "A list of UUID for every profile"
msgstr "Uma lista de UUID para cada perfil"

#: src/org.gnome.Ptyxis.gschema.xml.in:113 src/ptyxis-preferences-window.ui:328
msgid "New Tab Position"
msgstr "Posição da nova aba"

#: src/org.gnome.Ptyxis.gschema.xml.in:114
msgid "Where to place new tabs"
msgstr "Onde colocar novas abas"

#: src/org.gnome.Ptyxis.gschema.xml.in:119 src/ptyxis-preferences-window.ui:420
msgid "Audible Bell"
msgstr "Campainha audível"

#: src/org.gnome.Ptyxis.gschema.xml.in:120
msgid "If an audible bell should be used"
msgstr "Se uma campainha audível deve ser usada"

#: src/org.gnome.Ptyxis.gschema.xml.in:125
msgid "Visible Bell"
msgstr "Campainha visível"

#: src/org.gnome.Ptyxis.gschema.xml.in:126
msgid "If a visual bell should be used"
msgstr "Se uma campainha visual deve ser usado"

#: src/org.gnome.Ptyxis.gschema.xml.in:131 src/ptyxis-preferences-window.ui:128
msgid "Blur Background"
msgstr "Borrar plano de fundo"

#: src/org.gnome.Ptyxis.gschema.xml.in:132
msgid "Blur the background visible through transparent windows"
msgstr "Borra o plano de fundo visível em janelas transparentes"

#: src/org.gnome.Ptyxis.gschema.xml.in:137
msgid "Visual Process Leader"
msgstr "Líder de processo visual"

#: src/org.gnome.Ptyxis.gschema.xml.in:138
msgid ""
"Display a visual window highlight when process leader is SSH, sudo, or other "
"specialized tooling"
msgstr ""
"Exibe um realce de janela visual quando o líder do processo for SSH, sudo ou "
"outra ferramenta especializada"

#: src/org.gnome.Ptyxis.gschema.xml.in:143
msgid "Use System Font"
msgstr "Usar fonte do sistema"

#: src/org.gnome.Ptyxis.gschema.xml.in:144
msgid "If the default system monospace font should be used"
msgstr "Se a fonte monoespaçada padrão do sistema deve ser usada"

#: src/org.gnome.Ptyxis.gschema.xml.in:149
msgid "Font Name"
msgstr "Nome da fonte"

#: src/org.gnome.Ptyxis.gschema.xml.in:150
msgid "The font description to use if use-system-font is set to False"
msgstr ""
"A descrição da fonte a ser usada se use-system-font estiver definido como "
"False"

#: src/org.gnome.Ptyxis.gschema.xml.in:155 src/ptyxis-preferences-window.ui:255
msgid "Cursor Shape"
msgstr "Forma do cursor"

#: src/org.gnome.Ptyxis.gschema.xml.in:156
msgid "The default shape of the cursor"
msgstr "A forma padrão do cursor"

#: src/org.gnome.Ptyxis.gschema.xml.in:161
msgid "Cursor Blink Mode"
msgstr "Modo de intermitência do cursor"

#: src/org.gnome.Ptyxis.gschema.xml.in:162
msgid "The default blink mode cursor"
msgstr "O cursor do modo intermitente padrão"

#: src/org.gnome.Ptyxis.gschema.xml.in:167
msgid "List of punctuation characters that are treated as word characters"
msgstr ""
"Lista de caracteres de pontuação que são tratados como caracteres de palavra"

#: src/org.gnome.Ptyxis.gschema.xml.in:168
msgid ""
"By default, when doing word-wise selection, most punctuation breaks up word "
"boundaries. This list of exceptions will instead be treated as part of the "
"word."
msgstr ""
"Por padrão, quando estiver selecionando palavra a palavra, a maior parte da "
"pontuação quebra as barreiras da palavra. Esta lista de exceções será, ao "
"invés, tratada como parte da palavra."

#: src/org.gnome.Ptyxis.gschema.xml.in:173
msgid "Scrollbar Policy"
msgstr "Política da barra de rolagem"

#: src/org.gnome.Ptyxis.gschema.xml.in:174
msgid "If scrollbars should be displayed"
msgstr "Se as barras de rolagem devem ser exibidas"

#: src/org.gnome.Ptyxis.gschema.xml.in:179
msgid "Show window size popup"
msgstr "Mostrar popup de tamanho da janela"

#: src/org.gnome.Ptyxis.gschema.xml.in:180
msgid "Show a popup with the terminal grid size when the window is resized"
msgstr ""
"Mostra um popup com o tamanho da grade do terminal quando a janela é "
"redimensionada"

#: src/org.gnome.Ptyxis.gschema.xml.in:189
msgid "Text Blink Mode"
msgstr "Modo de intermitência de texto"

#: src/org.gnome.Ptyxis.gschema.xml.in:190
msgid "When text blinking is allowed"
msgstr "Quando a intermitência de texto é permitida"

#: src/org.gnome.Ptyxis.gschema.xml.in:195
msgid "Interface Style"
msgstr "Estilo de interface"

#: src/org.gnome.Ptyxis.gschema.xml.in:196
msgid "If light or dark interface style should be used"
msgstr "Se o estilo de interface claro ou escuro deve ser usado"

#: src/org.gnome.Ptyxis.gschema.xml.in:201 src/ptyxis-preferences-window.ui:357
msgid "Restore Session"
msgstr "Restaurar sessão"

#: src/org.gnome.Ptyxis.gschema.xml.in:202
msgid "Restore tabs from previous session when starting Ptyxis"
msgstr "Restaurar abas da sessão anterior ao iniciar o Ptyxis"

#: src/org.gnome.Ptyxis.gschema.xml.in:207 src/ptyxis-preferences-window.ui:363
msgid "Restore Window Size"
msgstr "Restaurar tamanho da janela"

#: src/org.gnome.Ptyxis.gschema.xml.in:208
msgid "Restore the previous window size when creating new windows"
msgstr "Restaura o tamanho da janela anterior ao criar novas janelas"

#: src/org.gnome.Ptyxis.gschema.xml.in:218
msgid "Default Column Size"
msgstr "Tamanho padrão da coluna"

#: src/org.gnome.Ptyxis.gschema.xml.in:219
#: src/org.gnome.Ptyxis.gschema.xml.in:226
msgid "Default window size when restore-window-size is not true."
msgstr "Tamanho padrão da janela quando restore-window-size não é verdadeiro."

#: src/org.gnome.Ptyxis.gschema.xml.in:225
msgid "Default Row Size"
msgstr "Tamanho padrão da linha"

#: src/org.gnome.Ptyxis.gschema.xml.in:231
msgid "Toast on Copy Clipboard"
msgstr "Toast ao copiar à área de transferência"

#: src/org.gnome.Ptyxis.gschema.xml.in:232
msgid "Show the user when text has copied to the clipboard."
msgstr ""
"Mostra ao usuário quando o texto foi copiado para a área de transferência."

#: src/org.gnome.Ptyxis.gschema.xml.in:237
msgid "Enable Accessibility"
msgstr "Habilitar acessibilidade"

#: src/org.gnome.Ptyxis.gschema.xml.in:238
msgid ""
"Currently experimental feature to send accessibility information to screen "
"readers."
msgstr ""
"Recurso atualmente experimental para enviar informações de acessibilidade "
"para leitores de tela."

#: src/org.gnome.Ptyxis.gschema.xml.in:243
msgid "Enable zoom on scroll holding the control key"
msgstr "Ativar a ampliação ao rolar segurando a tecla ctrl"

#: src/org.gnome.Ptyxis.gschema.xml.in:244
msgid ""
"Enable to adjust the zoom level on scroll scroll while holding the control "
"key."
msgstr ""
"Ativa o ajuste de nível da ampliação ao rolar enquanto segura a tecla ctrl. "

#: src/org.gnome.Ptyxis.gschema.xml.in:249
msgid "Disable Padding around Terminal Emulator"
msgstr "Desabilitar preenchimento ao redor do emulador de terminal"

#: src/org.gnome.Ptyxis.gschema.xml.in:250
msgid ""
"Do not pad around the terminal emulator widget. Setting to true may have "
"significant performance impacts."
msgstr ""
"Não preencha o widget do emulador de terminal. Definir como verdadeiro pode "
"ter impactos significativos no desempenho."

#: src/org.gnome.Ptyxis.gschema.xml.in:255
msgid "Prompt when active tab is closed"
msgstr "Solicitar confirmação quando a aba ativa está fechada"

#: src/org.gnome.Ptyxis.gschema.xml.in:256
msgid ""
"If a tab (or window) is closed with active foreground processes, prompt the "
"user for confirmation."
msgstr ""
"Se a aba (ou janela) estiver fechada com processos ativos em primeiro plano, "
"o solicita confirmação do usuário."

#. Translators: OSC stands for "Operating System Command" and is referencing in-band escape sequences from the child process to set the title
#: src/org.gnome.Ptyxis.gschema.xml.in:262
msgid "Ignore OSC Title"
msgstr "Ignorar título do OSC"

#: src/org.gnome.Ptyxis.gschema.xml.in:263
msgid "If OSC title should be ignored in tab titles."
msgstr ""
"Se o título do OSC (Comando de Sistema Operacional) deve ser ignorado nos "
"títulos das abas"

#: src/org.gnome.Ptyxis.gschema.xml.in:268 src/ptyxis-preferences-window.ui:437
msgid "Disable Dynamic Title"
msgstr "Desabilitar título dinâmico"

#: src/org.gnome.Ptyxis.gschema.xml.in:269
msgid "Disable dynamic title updates from running commands."
msgstr "Desabilita títulos dinâmicos atualizados por comandos em andamento."

#: src/org.gnome.Ptyxis.gschema.xml.in:275
msgid "Inhibit Logout"
msgstr "Inibir a saída de sessão"

#: src/org.gnome.Ptyxis.gschema.xml.in:276
msgid "Inhibit desktop logout when a foreground process is running in a tab."
msgstr "Inibir a saída da sessão enquanto um processo esteja rodando numa aba."

#: src/org.gnome.Ptyxis.gschema.xml.in:285
msgid "Label"
msgstr "Rótulo"

#: src/org.gnome.Ptyxis.gschema.xml.in:286
msgid "The label for the profile"
msgstr "O rótulo do perfil"

#: src/org.gnome.Ptyxis.gschema.xml.in:291
msgid "Login Shell"
msgstr "Login"

#: src/org.gnome.Ptyxis.gschema.xml.in:292
msgid "Use a login shell"
msgstr "Usa um shell de login"

#: src/org.gnome.Ptyxis.gschema.xml.in:297 src/ptyxis-preferences-window.ui:499
#: src/ptyxis-profile-editor.ui:333
msgid "Limit Scrollback"
msgstr "Limitar rolagem"

#: src/org.gnome.Ptyxis.gschema.xml.in:298
msgid "Limit the number of lines to keep for scrollback"
msgstr "Limita o número de linhas a serem mantidas para rolagem"

#: src/org.gnome.Ptyxis.gschema.xml.in:304 src/ptyxis-preferences-window.ui:508
#: src/ptyxis-profile-editor.ui:342
msgid "Scrollback Lines"
msgstr "Linhas de rolagem"

#: src/org.gnome.Ptyxis.gschema.xml.in:305
msgid "The number of lines to keep in the scrollback, zero for no scrollback"
msgstr ""
"O número de linhas a serem mantidas na rolagem, zero para nenhuma rolagem"

#: src/org.gnome.Ptyxis.gschema.xml.in:310 src/ptyxis-preferences-window.ui:489
#: src/ptyxis-profile-editor.ui:323
msgid "Scroll on Output"
msgstr "Rolar ao ter saída"

#: src/org.gnome.Ptyxis.gschema.xml.in:311
msgid "Scroll to the bottom upon new output"
msgstr "Rola até o final ao surgir nova saída"

#: src/org.gnome.Ptyxis.gschema.xml.in:316 src/ptyxis-preferences-window.ui:483
#: src/ptyxis-profile-editor.ui:317
msgid "Scroll on Keystroke"
msgstr "Rolar com o pressionar de tecla"

#: src/org.gnome.Ptyxis.gschema.xml.in:317
msgid "Scroll to the bottom upon user keystroke"
msgstr "Rola até a parte inferior quando o usuário pressiona uma tecla"

#: src/org.gnome.Ptyxis.gschema.xml.in:322 src/ptyxis-profile-editor.ui:187
msgid "Use Custom Command"
msgstr "Usar comando personalizado"

#: src/org.gnome.Ptyxis.gschema.xml.in:323
msgid "If a custom command should be used"
msgstr "Se um comando personalizado deve ser usado"

#: src/org.gnome.Ptyxis.gschema.xml.in:328
msgid "Use Proxy"
msgstr "Usar proxy"

#: src/org.gnome.Ptyxis.gschema.xml.in:329
msgid "Apply proxy settings from the host in the container"
msgstr "Aplica configurações de proxy do host no contêiner"

#: src/org.gnome.Ptyxis.gschema.xml.in:334 src/ptyxis-profile-editor.ui:192
msgid "Custom Command"
msgstr "Comando personalizado"

#: src/org.gnome.Ptyxis.gschema.xml.in:335
msgid "A custom command for the shell"
msgstr "Um comando personalizado para o shell"

#: src/org.gnome.Ptyxis.gschema.xml.in:340 src/ptyxis-profile-editor.ui:211
msgid "Default Container"
msgstr "Contêiner padrão"

#: src/org.gnome.Ptyxis.gschema.xml.in:341
msgid "The default container to run the command in"
msgstr "O contêiner padrão para executar o comando"

#: src/org.gnome.Ptyxis.gschema.xml.in:346 src/ptyxis-profile-editor.ui:220
msgid "Preserve Container"
msgstr "Preservar contêiner"

#: src/org.gnome.Ptyxis.gschema.xml.in:347
msgid "Preserve the active container when creating new tabs and windows"
msgstr "Preservar o contêiner ativo ao criar novas abas e janelas"

#: src/org.gnome.Ptyxis.gschema.xml.in:352 src/ptyxis-preferences-window.ui:568
#: src/ptyxis-profile-editor.ui:281
msgid "Exit Action"
msgstr "Ação de saída"

#: src/org.gnome.Ptyxis.gschema.xml.in:353
msgid "The action to take when the shell exits"
msgstr "A ação a ser tomada quando o shell é encerrado"

#: src/org.gnome.Ptyxis.gschema.xml.in:358
msgid "Preserve Directory"
msgstr "Preservar diretório"

#: src/org.gnome.Ptyxis.gschema.xml.in:359
msgid "If the directory should be preserved for new terminals"
msgstr "Se o diretório deve ser preservado para novos terminais"

#: src/org.gnome.Ptyxis.gschema.xml.in:364 src/ptyxis-inspector.ui:108
#: src/ptyxis-preferences-window.ui:41 src/ptyxis-profile-editor.ui:65
msgid "Palette"
msgstr "Paleta"

#: src/org.gnome.Ptyxis.gschema.xml.in:365
msgid "The color palette to use for the profile, by name"
msgstr "A paleta de cores a ser usada no perfil, por nome"

#: src/org.gnome.Ptyxis.gschema.xml.in:371
msgid "Opacity"
msgstr "Opacidade"

#: src/org.gnome.Ptyxis.gschema.xml.in:372
msgid "The opacity of the palette background"
msgstr "A opacidade do fundo da paleta"

#: src/org.gnome.Ptyxis.gschema.xml.in:377
msgid "Bold is Bright"
msgstr "Negrito é brilhante"

#: src/org.gnome.Ptyxis.gschema.xml.in:378
msgid ""
"Setting bold on one of the lower 8 colors in the palette will use bright "
"variant (upper 8 colors)"
msgstr ""
"Definir negrito em uma das 8 cores inferiores da paleta usará a variante "
"brilhante (8 cores superiores)"

#: src/org.gnome.Ptyxis.gschema.xml.in:384 src/ptyxis-preferences-window.ui:181
#: src/ptyxis-profile-editor.ui:143
msgid "Line Spacing"
msgstr "Espaçamento de linha"

#: src/org.gnome.Ptyxis.gschema.xml.in:385
msgid "The terminal’s cell height scale"
msgstr "A escala de altura de célula do terminal"

#: src/org.gnome.Ptyxis.gschema.xml.in:391 src/ptyxis-preferences-window.ui:195
#: src/ptyxis-profile-editor.ui:157
msgid "Column Spacing"
msgstr "Espaçamento de coluna"

#: src/org.gnome.Ptyxis.gschema.xml.in:392
msgid "The terminal’s cell width scale"
msgstr "A escala de largura da célula do terminal"

#: src/org.gnome.Ptyxis.gschema.xml.in:397
msgid "CJK Ambiguous Width"
msgstr "Largura ambígua de CJK"

#: src/org.gnome.Ptyxis.gschema.xml.in:398
msgid "The size to apply to ambiguous width characters"
msgstr "O tamanho a ser aplicado a caracteres de largura ambígua"

#: src/org.gnome.Ptyxis.gschema.xml.in:403
#: src/org.gnome.Ptyxis.gschema.xml.in:409
msgid "Backspace Binding"
